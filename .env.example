# ==============================================================================
# InternCert Master Environment Template (.env.example)
# ==============================================================================
# Copy this file or the respective folder-level .env.example files:
#   - Backend config goes to: server/.env
#   - Frontend config goes to: project/.env (or project/.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------

# Server Environment
PORT=5000
NODE_ENV=development
TRUST_PROXY=1
LOG_LEVEL=debug

# Database (MongoDB connection string)
# Local: mongodb://localhost:27017/interncert
# Live: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/interncert?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interncert

# Security & Auth (MUST be >= 32 characters in production)
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars
ADMIN_MFA_ENFORCED=false

# Frontend Origin (Used for CORS headers and email verification/password reset URLs)
# Local: http://localhost:5173
# Live: https://interncert.com (must be https in production)
FRONTEND_URL=http://localhost:5173

# Payment Gateway (Razorpay)
# Mode: 'mock' (for local testing without real money) | 'live' (production)
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Transactional Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="InternCert <noreply@yourdomain.com>"
CONTACT_TO_EMAIL=admin@yourdomain.com

# File & Certificate Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Redis (e.g. Upstash Redis for distributed rate-limiting)
REDIS_URL=

# Optional: Cloudflare Turnstile Bot Protection Secret Key
TURNSTILE_SECRET_KEY=

# Optional: Scrape token for /api/metrics endpoint
METRICS_TOKEN=

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (project/.env or project/.env.production)
# ------------------------------------------------------------------------------

# Backend API Base URL
# Local: http://localhost:5000/api
# Live: https://api.yourdomain.com/api (or https://your-backend.koyeb.app/api)
VITE_API_URL=http://localhost:5000/api
