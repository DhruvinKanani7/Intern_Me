# ==============================================================================
# InternCert Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
TRUST_PROXY=1
LOG_LEVEL=debug

# Database (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/interncert

# Security & Authentication (Min 32 characters in production)
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars
ADMIN_MFA_ENFORCED=false

# Frontend Application Origin (Used for CORS and email verification links)
# Dev: http://localhost:5173 | Prod: https://your-production-domain.com
FRONTEND_URL=http://localhost:5173

# Payment Gateway (Razorpay)
# Mode: 'mock' for local development & testing | 'live' for real payments
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Transactional Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="InternCert <noreply@your-verified-domain.com>"
CONTACT_TO_EMAIL=admin@example.com

# Media & Certificate PDF Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Redis Cache & Distributed Rate Limiting (Upstash / Redis)
REDIS_URL=

# Optional: Cloudflare Turnstile Bot Protection (For contact/auth forms)
TURNSTILE_SECRET_KEY=

# Optional: Prometheus / Metrics Endpoint Scrape Token
METRICS_TOKEN=
